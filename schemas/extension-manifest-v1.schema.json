{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srikanthkurva71-sys/Gocode-IDE/schemas/extension-manifest-v1.schema.json",
  "title": "Gocode IDE Extension Manifest v1",
  "description": "Pre-release package metadata schema. Runtime validators additionally enforce UTF-8 byte limits and reject Unicode control characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "license",
    "description"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1,
      "type": "integer",
      "description": "Exact extension manifest schema version."
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    }
  }
}
